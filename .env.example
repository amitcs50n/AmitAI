HF_TOKEN=hf_your_token_here
WANDB_DISABLED=true

# Local control plane and server-side Next.js proxy. The backend generates its
# bearer token per launch; this optional non-secret path override must match in
# the backend and Next server environments.
AMITAI_LOCAL_API_TOKEN_FILE=
AMITAI_API_ORIGIN=http://127.0.0.1:8000
AMITAI_HOST=127.0.0.1
AMITAI_PORT=8000
AMITAI_ALLOW_LAN=0
AMITAI_ENABLE_DEV_DOCS=0

# Plaintext-to-SQLCipher migration remains an explicit offline launch option.
# Database keys and unlock passphrases are never configured here.
AMITAI_ENCRYPT_EXISTING_DB=0

# Remote inference client (local control plane only). Do not reuse the local token.
AMITAI_REMOTE_INFERENCE_URL=https://your-development-inference-endpoint.example
# Exact comma-separated origins only; update alongside URL when the pod changes.
# Example: https://<POD-ID>-8000.proxy.runpod.net (never *.proxy.runpod.net).
AMITAI_REMOTE_INFERENCE_ALLOWED_ORIGINS=https://your-development-inference-endpoint.example
# Generate a fresh session token with: python -m runtime.inference_token
# Both sides require >=32 printable ASCII characters, without whitespace/controls.
AMITAI_REMOTE_INFERENCE_TOKEN=

# GPU inference service credential. Configure on that service only and keep it
# distinct from local control-plane authentication. Must match the client token
# for this inference session; do not reuse a permanent token across pods.
AMITAI_INFERENCE_AUTH_TOKEN=
