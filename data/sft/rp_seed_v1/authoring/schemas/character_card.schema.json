{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitai.local/schemas/aevon-rp-character-card-v1.json",
  "title": "Aevon RP seed character card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "character_id", "name", "age", "pronouns", "fictional_status",
    "real_person_reference", "adult_capable", "physical_description",
    "personality", "voice_style", "background", "motivations", "likes",
    "dislikes", "strengths", "flaws", "boundaries",
    "relationship_context", "setting_lore", "continuity_facts",
    "behavior_constraints", "author_source", "ownership_license", "revision"
  ],
  "properties": {
    "character_id": {"type": "string", "pattern": "^char_[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "age": {"type": "integer", "minimum": 21, "maximum": 100},
    "pronouns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fictional_status": {"const": "original_fictional_adult"},
    "real_person_reference": {"const": false},
    "adult_capable": {"type": "boolean"},
    "physical_description": {"type": "string", "minLength": 20},
    "personality": {"type": "array", "minItems": 3, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "voice_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "cadence", "humor", "vocabulary", "avoids"],
      "properties": {
        "register": {"type": "string"},
        "cadence": {"type": "string"},
        "humor": {"type": "string"},
        "vocabulary": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "avoids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "background": {"type": "string", "minLength": 40},
    "motivations": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "likes": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "dislikes": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "strengths": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "flaws": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft", "stop_behavior"],
      "properties": {
        "hard": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "soft": {"type": "array", "items": {"type": "string"}},
        "stop_behavior": {"type": "string", "minLength": 20}
      }
    },
    "relationship_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_stage", "permitted_dynamics", "adult_context_constraints"],
      "properties": {
        "default_stage": {"type": "string"},
        "permitted_dynamics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "adult_context_constraints": {"type": "string"}
      }
    },
    "setting_lore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home_setting", "genre", "facts"],
      "properties": {
        "home_setting": {"type": "string"},
        "genre": {"type": "string"},
        "facts": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    },
    "continuity_facts": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "behavior_constraints": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "author_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_slot", "author_id", "source_type", "source_ref"],
      "properties": {
        "author_slot": {"pattern": "^author_slot_0[1-4]$"},
        "author_id": {"type": ["string", "null"], "pattern": "^author_[a-z0-9_]+$"},
        "source_type": {"enum": ["original_design_draft", "human_original", "human_revision"]},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "ownership_license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_status", "ownership_declaration_id", "license_id", "training_permission", "modification_permission", "redistribution_permission"],
      "properties": {
        "rights_status": {"enum": ["pending", "reviewed", "blocked", "rejected"]},
        "ownership_declaration_id": {"type": ["string", "null"]},
        "license_id": {"type": "string", "minLength": 1},
        "training_permission": {"type": "boolean"},
        "modification_permission": {"type": "boolean"},
        "redistribution_permission": {"type": "boolean"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_version", "revision", "content_sha256"],
      "properties": {
        "card_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
