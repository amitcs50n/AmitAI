{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitai.local/schemas/aevon-rp-scene-plan-v1.json",
  "title": "Aevon RP seed scene allocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_id", "character_id", "category", "scenario_family", "setting",
    "relationship_stage", "emotional_tone", "conflict_or_objective",
    "expected_state_change", "expected_user_decision_points",
    "boundary_refusal_opportunity", "enacted_state_change_required",
    "boundary_refusal_required", "length_band", "target_turn_range",
    "target_token_range", "author_assignment", "evaluation_risk_notes",
    "heldout_scenario_family_reserved"
  ],
  "properties": {
    "scene_id": {"type": "string", "pattern": "^scene_[a-z0-9_]+$"},
    "character_id": {"type": "string", "pattern": "^char_[a-z0-9_]+$"},
    "category": {"enum": ["sfw", "mature_nonsexual", "adult_capable"]},
    "scenario_family": {"type": "string", "pattern": "^train_[a-z0-9_]+$"},
    "setting": {"type": "string", "minLength": 20},
    "relationship_stage": {"type": "string"},
    "emotional_tone": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "conflict_or_objective": {"type": "string", "minLength": 20},
    "expected_state_change": {"type": "string", "minLength": 20},
    "expected_user_decision_points": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "boundary_refusal_opportunity": {"type": "string", "minLength": 10},
    "enacted_state_change_required": {"type": "boolean"},
    "boundary_refusal_required": {"type": "boolean"},
    "length_band": {"enum": ["short", "medium", "long"]},
    "target_turn_range": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
    "target_token_range": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
    "author_assignment": {"pattern": "^author_slot_0[1-4]$"},
    "evaluation_risk_notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "heldout_scenario_family_reserved": {"const": false}
  }
}
