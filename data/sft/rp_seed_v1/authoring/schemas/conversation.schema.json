{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitai.local/schemas/aevon-rp-conversation-v1.json",
  "title": "Aevon human-authored RP conversation v1",
  "description": "Future author submission contract. No records are authorized or training-ready by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "spec_version", "category", "primary_rules", "messages",
    "scene_metadata", "character_refs", "continuity_state", "events",
    "provenance_id", "review_status", "training_ready"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "spec_version": {"const": "1.2.0"},
    "category": {"const": "creative_roleplay"},
    "primary_rules": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"},
      "allOf": [{"contains": {"const": "ROLEPLAY-001"}}, {"contains": {"const": "CONTEXT-005"}}]
    },
    "messages": {
      "type": "array", "minItems": 7,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      },
      "contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "user"}}},
      "minContains": 3
    },
    "scene_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_id", "content_tier", "length_band", "setting", "relationship_stage", "user_role", "known_user_facts", "forbidden_user_assumptions", "all_participants_21_plus", "intermediate_state_beats", "shared_history_facts", "adult_content_ceiling", "state_before", "state_after"],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^scene_[a-z0-9_]+$"},
        "content_tier": {"enum": ["sfw", "mature_nonsexual", "adult_capable"]},
        "length_band": {"enum": ["short", "medium", "long"]},
        "setting": {"type": "string"},
        "relationship_stage": {"type": "string"},
        "user_role": {"type": "string", "minLength": 10},
        "known_user_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_user_assumptions": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "contains": {"const": "unexpressed consent"}},
        "all_participants_21_plus": {"const": true},
        "intermediate_state_beats": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
        "shared_history_facts": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
        "adult_content_ceiling": {"enum": ["not_applicable", "fade_to_black_no_graphic_sex"]},
        "state_before": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "state_after": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"length_band": {"const": "long"}}, "required": ["length_band"]},
          "then": {"properties": {"intermediate_state_beats": {"minItems": 3, "maxItems": 5}}}
        },
        {
          "if": {"properties": {"content_tier": {"const": "mature_nonsexual"}}, "required": ["content_tier"]},
          "then": {"properties": {"shared_history_facts": {"minItems": 1, "maxItems": 2}}}
        },
        {
          "if": {"properties": {"content_tier": {"const": "adult_capable"}}, "required": ["content_tier"]},
          "then": {"properties": {"adult_content_ceiling": {"const": "fade_to_black_no_graphic_sex"}}},
          "else": {"properties": {"adult_content_ceiling": {"const": "not_applicable"}}}
        }
      ]
    },
    "character_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^char_[a-z0-9_]+$"}},
    "continuity_state": {
      "type": "object", "additionalProperties": false,
      "required": ["facts_before", "facts_added", "facts_changed"],
      "properties": {
        "facts_before": {"type": "array", "items": {"type": "string"}},
        "facts_added": {"type": "array", "items": {"type": "string"}},
        "facts_changed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "event_type", "actor_ref", "summary", "training_inclusion"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^event_[a-z0-9_]+$"},
          "event_type": {"enum": ["action", "scene_exit", "assistant_switchback"]},
          "actor_ref": {"type": "string"},
          "summary": {"type": "string"},
          "training_inclusion": {"const": false}
        }
      }
    },
    "provenance_id": {"type": "string", "pattern": "^prov_[a-z0-9_]+$"},
    "review_status": {"enum": ["pending", "accepted", "hold", "rejected"]},
    "training_ready": {"const": false}
  }
}
