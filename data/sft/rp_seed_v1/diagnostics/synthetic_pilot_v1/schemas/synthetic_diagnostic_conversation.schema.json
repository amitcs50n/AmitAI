{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitai.local/schemas/aevon-rp-synthetic-diagnostic-conversation-v1.json",
  "title": "Aevon RP synthetic diagnostic conversation V1",
  "description": "AI diagnostic evidence only. This shape is intentionally incompatible with the SFT loader and cannot be training-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagnostic_scene_id",
    "source_scene_id",
    "source_character_id",
    "content_tier",
    "length_band",
    "source_refs",
    "transcript",
    "scene_state",
    "provenance_id",
    "diagnostic_only",
    "training_ready"
  ],
  "properties": {
    "schema_version": {"const": "aevon_rp_synthetic_diagnostic_scene_v1"},
    "diagnostic_scene_id": {"type": "string", "pattern": "^diagnostic_scene_[a-z0-9_]+_v1$"},
    "source_scene_id": {"type": "string", "pattern": "^scene_[a-z0-9_]+$"},
    "source_character_id": {"type": "string", "pattern": "^char_[a-z0-9_]+$"},
    "content_tier": {"enum": ["sfw", "mature_nonsexual", "adult_capable"]},
    "length_band": {"enum": ["short", "medium", "long"]},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_card_version", "character_card_revision", "scene_plan_file", "character_card_file"],
      "properties": {
        "character_card_version": {"const": "1.1.0"},
        "character_card_revision": {"type": "integer", "minimum": 1},
        "scene_plan_file": {"const": "data/sft/rp_seed_v1/authoring/scene_allocation.yaml"},
        "character_card_file": {"const": "data/sft/rp_seed_v1/authoring/roster.yaml"}
      }
    },
    "transcript": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn", "speaker_type", "speaker_id", "content"],
        "properties": {
          "turn": {"type": "integer", "minimum": 1},
          "speaker_type": {"enum": ["diagnostic_user", "diagnostic_character"]},
          "speaker_id": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "scene_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_before", "state_after", "user_decision_points_exercised", "boundary_outcome", "events"],
      "properties": {
        "state_before": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "state_after": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "user_decision_points_exercised": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "boundary_outcome": {"type": "string", "minLength": 1},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_type", "actor", "summary"],
            "properties": {
              "event_type": {"enum": ["action", "state_change", "boundary", "scene_exit", "assistant_switchback"]},
              "actor": {"type": "string"},
              "summary": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "provenance_id": {"type": "string", "pattern": "^prov_diagnostic_[a-z0-9_]+_v1$"},
    "diagnostic_only": {"const": true},
    "training_ready": {"const": false}
  },
  "not": {"required": ["messages"]}
}
