{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitai.local/schemas/original-rp-provenance-v1.json",
  "title": "AmitAI original-author RP provenance record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance_id", "author", "source_record_location", "ownership_declaration", "permission", "revisions", "source_hashes", "lineage", "human_review"],
  "properties": {
    "provenance_id": {"type": "string", "pattern": "^prov_[a-z0-9_]+$"},
    "source_record_location": {"type": "string", "minLength": 1},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_ref", "identity_record_location", "contact_record_location"],
      "properties": {
        "author_ref": {"type": "string", "pattern": "^author_[a-z0-9_]+$"},
        "identity_record_location": {"type": "string"},
        "contact_record_location": {"type": "string"}
      }
    },
    "ownership_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_work", "no_real_person_imitation", "third_party_material_disclosed", "signed_at", "document_sha256"],
      "properties": {
        "original_work": {"const": true},
        "no_real_person_imitation": {"const": true},
        "third_party_material_disclosed": {"type": "boolean"},
        "signed_at": {"type": "string", "format": "date-time"},
        "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_id", "license_text_sha256", "grants_training_use", "grants_modification", "grants_redistribution", "attribution_required"],
      "properties": {
        "license_id": {"type": "string"},
        "license_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "grants_training_use": {"type": "boolean"},
        "grants_modification": {"type": "boolean"},
        "grants_redistribution": {"type": "boolean"},
        "attribution_required": {"type": "boolean"}
      }
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "timestamp", "author_ref", "source_sha256", "change_summary"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "author_ref": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "change_summary": {"type": "string"}
        }
      }
    },
    "source_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "parent_ids", "teacher_model", "generation_run_id", "prompt_template_sha256"],
      "properties": {
        "origin": {"enum": ["human_original", "human_revision", "synthetic_derivative"]},
        "parent_ids": {"type": "array", "items": {"type": "string"}},
        "teacher_model": {"type": ["string", "null"]},
        "generation_run_id": {"type": ["string", "null"]},
        "prompt_template_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_status", "reviewer_ref", "reviewed_at", "notes"],
      "properties": {
        "rights_status": {"enum": ["pending", "reviewed", "blocked", "rejected"]},
        "reviewer_ref": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}
